{
  "name": "alquilometro",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"pnpm dev:api\" \"pnpm dev:web\"",
    "dev:api": "node --env-file-if-exists=.env --watch --import tsx src/server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env --import tsx src/server/index.ts",
    "db:up": "docker compose up -d db",
    "db:generate": "drizzle-kit generate",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:backup": "mkdir -p backups && docker compose exec -T db pg_dump -U alquileres -d alquileres -Fc > backups/alquileres-$(date +%Y%m%d-%H%M%S).dump && echo Backup OK",
    "db:push-railway": "bash scripts/push-db-to-railway.sh"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.7",
    "@tanstack/react-query": "^5.107.1",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.18",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.72.0",
    "postgres": "^4.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-leaflet": "^5.0.0",
    "react-router": "^8.5.1",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "drizzle-kit": "^0.31.11",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
